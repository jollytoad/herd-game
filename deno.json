{
  "unstable": [
    "kv",
    "no-legacy-abort"
  ],
  "tasks": {
    "dev": {
      "description": "Dev server with --watch and .env loading",
      "command": "deno run --allow-net --allow-env=PORT,OLLAMA_API_KEY,OLLAMA_BASE_URL,LLM_MODEL,KV_PREFIX --allow-read=. --env-file --watch dev.ts"
    },
    "start": "deno run --allow-net --allow-env=PORT,OLLAMA_API_KEY,OLLAMA_BASE_URL,LLM_MODEL,KV_PREFIX --allow-read=. main.ts",
    "gen": "deno run --allow-net=jsr.io,plugins.dprint.dev --allow-read=. --allow-write=src/routes.ts --unstable-kv --allow-env=OLLAMA_API_KEY,OLLAMA_BASE_URL,LLM_MODEL scripts/gen.ts",
    "test:e2e": {
      "description": "Run the Gherkin/Playwright suite against HERD_BASE_URL (defaults to localhost:8000). Codegen runs first so an edited .feature is never silently skipped; extra args are appended to the playwright call, e.g. --list or --ui",
      "command": "deno run -A npm:playwright-bdd && deno run -A npm:@playwright/test test"
    },
    "test:e2e:list": {
      "description": "List generated scenarios without running them",
      "command": "deno run -A npm:playwright-bdd && deno run -A npm:@playwright/test test --list"
    },
    "check": "deno check main.ts",
    "ci": "deno fmt --check && deno lint && deno check main.ts",
    "ok": "deno fmt && deno lint && deno check main.ts"
  },
  "exclude": [
    ".agents/",
    "playwright-bdd-gen/",
    "test-results/",
    "playwright-report/"
  ],
  "imports": {
    "@http/fs": "jsr:@http/fs@^0.30.0",
    "@http/discovery": "jsr:@http/discovery@0.30.0",
    "@http/generate": "jsr:@http/generate@0.30.0",
    "@http/host-deno-deploy": "jsr:@http/host-deno-deploy@^0.30.0",
    "@http/host-deno-local": "jsr:@http/host-deno-local@^0.30.0",
    "@http/html-stream": "jsr:@http/html-stream@^0.11.0",
    "@http/interceptor": "jsr:@http/interceptor@^0.30.0",
    "@http/jsx-stream": "jsr:@http/jsx-stream@^0.11.0",
    "@http/request": "jsr:@http/request@^0.30.0",
    "@http/response": "jsr:@http/response@^0.30.0",
    "@http/route": "jsr:@http/route@^0.30.0",
    "@http/token-stream": "jsr:@http/token-stream@^0.11.0",
    "@playwright/test": "npm:@playwright/test@^1.63.0",
    "@std/http": "jsr:@std/http@^1.1.3",
    "@std/media-types": "jsr:@std/media-types@^1.1.0",
    "playwright": "npm:playwright@^1.63.0",
    "playwright-bdd": "npm:playwright-bdd@^9.2.1",
    "zod": "jsr:@zod/zod@4.6.5"
  },
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "jsx": "precompile",
    "jsxImportSource": "@http/jsx-stream"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": ["jsx-key"]
    }
  },
  "fmt": {
    "lineWidth": 100
  }
}
