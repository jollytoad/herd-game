{
  "tasks": {
    "dev": {
      "description": "Dev server with OpenTelemetry (console exporter \u2014 spans/metrics/logs print to stderr)",
      "command": "OTEL_DENO=true deno run --allow-net --allow-env=PORT,OPENAI_API_KEY,OPENAI_BASE_URL,LLM_MODEL --allow-read=. --env-file --unstable-kv --watch main.ts"
    },
    "dev:otlp": {
      "description": "Dev server exporting OTLP to a collector (default localhost:4318) \u2014 pair with `deno task otel`",
      "command": "OTEL_DENO=true deno run --allow-net --allow-read=. --allow-env=PORT,OPENAI_API_KEY,OPENAI_BASE_URL,LLM_MODEL,OTEL_EXPORTER_OTLP_ENDPOINT,OTEL_EXPORTER_OTLP_PROTOCOL,OTEL_EXPORTER_OTLP_HEADERS --env-file --unstable-kv --watch main.ts"
    },
    "otel": {
      "description": "Local LGTM stack (Grafana :3000 admin/admin, Loki, Tempo, Prometheus) + OTLP :4318",
      "command": "docker run --name lgtm -p 3000:3000 -p 4317:4317 -p 4318:4318 --rm -ti docker.io/grafana/otel-lgtm:latest"
    },
    "start": "deno run --allow-net --allow-env=PORT,OPENAI_API_KEY,OPENAI_BASE_URL,LLM_MODEL --unstable-kv main.ts",
    "check": "deno check main.ts",
    "ci": "deno fmt --check && deno lint && deno check main.ts",
    "ok": "deno fmt && deno lint && deno check main.ts"
  },
  "exclude": [
    ".agents/"
  ],
  "imports": {
    "@http/host-deno-local": "jsr:@http/host-deno-local@^0.28.0",
    "@http/html-stream": "jsr:@http/html-stream@^0.11.0",
    "@http/jsx-stream": "jsr:@http/jsx-stream@^0.11.0",
    "@http/response": "jsr:@http/response@^0.28.0",
    "@http/route": "jsr:@http/route@^0.28.0",
    "@http/token-stream": "jsr:@http/token-stream@^0.11.0",
    "@opentelemetry/api": "npm:@opentelemetry/api@^1.9.1",
    "@std/http": "jsr:@std/http@^1.1.3",
    "zod": "jsr:@zod/zod@4.5.4"
  },
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "jsx": "precompile",
    "jsxImportSource": "@http/jsx-stream"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": ["jsx-key"]
    }
  },
  "fmt": {
    "lineWidth": 100
  }
}
