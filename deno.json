{
  "unstable": [
    "kv",
    "no-legacy-abort"
  ],
  "tasks": {
    "dev": {
      "description": "Dev server with --watch and .env loading",
      "command": "deno run --allow-net --allow-env=PORT,OLLAMA_API_KEY,OLLAMA_BASE_URL,LLM_MODEL --allow-read=. --env-file --watch main.ts"
    },
    "start": "deno run --allow-net --allow-env=PORT,OLLAMA_API_KEY,OLLAMA_BASE_URL,LLM_MODEL main.ts",
    "check": "deno check main.ts",
    "ci": "deno fmt --check && deno lint && deno check main.ts",
    "ok": "deno fmt && deno lint && deno check main.ts"
  },
  "exclude": [
    ".agents/"
  ],
  "imports": {
    "@http/fs": "jsr:@http/fs@^0.30.0",
    "@http/host-deno-local": "jsr:@http/host-deno-local@^0.30.0",
    "@http/html-stream": "jsr:@http/html-stream@^0.11.0",
    "@http/interceptor": "jsr:@http/interceptor@^0.30.0",
    "@http/jsx-stream": "jsr:@http/jsx-stream@^0.11.0",
    "@http/request": "jsr:@http/request@^0.30.0",
    "@http/response": "jsr:@http/response@^0.30.0",
    "@http/route": "jsr:@http/route@^0.30.0",
    "@http/token-stream": "jsr:@http/token-stream@^0.11.0",
    "@std/http": "jsr:@std/http@^1.1.3",
    "@std/media-types": "jsr:@std/media-types@^1.1.0",
    "zod": "jsr:@zod/zod@4.6.2"
  },
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "jsx": "precompile",
    "jsxImportSource": "@http/jsx-stream"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": ["jsx-key"]
    }
  },
  "fmt": {
    "lineWidth": 100
  }
}
